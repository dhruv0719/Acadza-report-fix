# ==============================================================================
# Acadza AI Report-to-Fix System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# Never commit the .env file containing real API keys or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider options:
#   - 'groq' : Primary production provider (using official Groq Python SDK)
#   - 'mock' : Deterministic offline mode (used for tests without API credits)
LLM_PROVIDER=groq

# Groq Cloud API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Primary reasoning model for JEE/NEET multi-stage problem solving
LLM_MODEL=openai/gpt-oss-120b

# Fallback model in case of capacity or rate-limit saturation
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# Sampling temperature (0.0 for deterministic, reproducible academic reasoning)
LLM_TEMPERATURE=0

# Reasoning effort level: 'high' | 'medium' | 'low'
LLM_REASONING_EFFORT=high

# Execution mode: 'live' for API execution, 'mock' for local offline testing
LLM_MODE=live

# Enforce strict JSON Schema structured output
LLM_STRUCTURED_OUTPUT=true


# ------------------------------------------------------------------------------
# 2. Free-Tier Optimization & Rate Limit Controls
# ------------------------------------------------------------------------------
# Maximum concurrent requests (set to 1 to stay within Groq free-tier limits)
LLM_MAX_CONCURRENCY=1

# Request timeout in seconds
LLM_TIMEOUT=60

# Maximum retry attempts with adaptive exponential backoff on HTTP 429
LLM_MAX_RETRIES=3


# ------------------------------------------------------------------------------
# 3. Server & Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000


# ------------------------------------------------------------------------------
# 4. Project-Relative Data Paths
# ------------------------------------------------------------------------------
DATA_RAW_DIR=data/raw
TAXONOMY_PATH=data/raw/taxonomy.json
QUESTIONS_PATH=data/raw/questions.json
REPORTS_PATH=data/raw/reports.json
RESULTS_PATH=results.json
QUALITY_FINDINGS_PATH=data/question_quality_findings.json
UNREPORTED_AUDIT_PATH=data/unreported_question_audit.json
TELEMETRY_LOG_PATH=data/llm_usage_log.json
CHECKPOINTS_PATH=data/investigation_checkpoints.json
PRECHECK_FINDINGS_PATH=data/precheck_findings.json
PRECHECK_SUMMARY_PATH=data/precheck_summary.json
FACULTY_REVIEWS_PATH=data/faculty_reviews.json


# ------------------------------------------------------------------------------
# 5. Frontend & CORS Settings
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
